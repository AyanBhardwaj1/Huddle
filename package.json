{
  "name": "huddle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "turbo run test && pnpm test:scripts",
    "lint": "eslint .",
    "dev": "turbo run dev --parallel",
    "demo": "tsx scripts/demo.ts",
    "engine": "pnpm --filter @huddle/engine dev",
    "bridge:mock": "pnpm --filter @huddle/box-bridge dev -- --mock",
    "solana:test": "sh scripts/solana-test.sh",
    "solana:setup": "tsx scripts/solana-setup.ts",
    "solana:deploy": "sh scripts/solana-deploy.sh",
    "bots": "pnpm --filter @huddle/engine bots --",
    "e2e": "playwright test -c e2e",
    "e2e:install": "playwright install --only-shell chromium",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "quicknode:stream": "tsx scripts/quicknode/create-stream.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@huddle/engine": "workspace:^",
    "@huddle/shared": "workspace:^",
    "@huddle/solana-client": "workspace:^",
    "@playwright/test": "1.56.1",
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
