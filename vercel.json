{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @huddle/player... --filter @huddle/box...",
  "buildCommand": "pnpm --filter @huddle/player --filter @huddle/box build && node scripts/vercel-assemble.mjs",
  "outputDirectory": ".vercel-site",
  "rewrites": [
    { "source": "/box", "destination": "/box/index.html" },
    { "source": "/box/:path*", "destination": "/box/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)\\.(js|css|woff2|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
