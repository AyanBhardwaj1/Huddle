# Huddle environment. Copy to .env (gitignored). Everything is optional:
# with nothing set, the full demo runs in Replay mode with mocks and points settlement.
# DEVNET ONLY. Never put a mainnet key in here.

# --- Engine ---
PORT=8080                  # engine HTTP + WebSocket port (box UI at /box, player app at /)
DATA_DIR=./data            # SQLite file lives here
SETTLEMENT=points          # points | trusted | vault   (points = no chain calls at all)
PUBLIC_ENGINE_URL=         # tunnel URL for remote players (e.g. https://huddle.example.com)
BRIDGE_URL=ws://localhost:7777

# --- Solana (devnet) ---
SOLANA_RPC_URL=            # QuickNode devnet endpoint preferred
SOLANA_CLUSTER=devnet      # devnet | localnet
SOLANA_WS_URL=             # optional; derived from SOLANA_RPC_URL when empty
HUDDLE_PROGRAM_ID=GRpABdrQhDya9n2zuf19w2idbL3CRSqmWYTJs52taRHu   # set by scripts/solana-setup.ts after the deploy
USDC_MINT=                 # devnet USDC mint
TREASURY_SECRET_KEY=       # fee payer + faucet (devnet only)
BOX_SIGNER_SECRET_KEY=     # box key (on the box only)
QUICKNODE_STREAM_SECRET=   # verify webhook

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_SOCCER=
ELEVENLABS_VOICE_NFL=
ELEVENLABS_VOICE_CALM=
AGENT_TOOLS_SECRET=        # shared secret header for ElevenLabs agent server tools

# --- Sports data ---
SPORTS_PROVIDER=replay     # replay | espn | apifootball
API_FOOTBALL_KEY=

# --- Gemini Prediction Markets (public reads, no key) ---
GEMINI_API_BASE=https://api.gemini.com
GEMINI_MOCK=               # set to 1 to force the offline mock

# --- Optional announcer overrides (see docs/workstreams/A6.md) ---
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_AGENT_ID_SOCCER=
# ELEVENLABS_AGENT_ID_NFL=
# ELEVENLABS_AGENT_ID_CALM=
