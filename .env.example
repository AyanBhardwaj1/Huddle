# Huddle environment. Copy to .env (gitignored). Everything is optional:
# with nothing set, the full demo runs in Replay mode with mocks and points settlement.
# DEVNET ONLY. Never put a mainnet key in here.

# --- Engine ---
PORT=8080                  # engine HTTP + WebSocket port (box UI at /box, player app at /)
DATA_DIR=./data            # SQLite file lives here
SETTLEMENT=points          # points | trusted | vault   (points = no chain calls at all)
PUBLIC_ENGINE_URL=         # tunnel URL for remote players (e.g. https://huddle.example.com)
BRIDGE_URL=ws://localhost:7777

# --- Solana (devnet) ---
SOLANA_RPC_URL=            # QuickNode devnet endpoint preferred
SOLANA_CLUSTER=devnet      # devnet | localnet (localnet = a local solana-test-validator)
SOLANA_WS_URL=             # optional; derived from SOLANA_RPC_URL when empty
HUDDLE_PROGRAM_ID=GRpABdrQhDya9n2zuf19w2idbL3CRSqmWYTJs52taRHu   # keypair-derived; NOT deployed to devnet yet (docs/workstreams/A1.md)
USDC_MINT=                 # devnet USDC mint
TREASURY_SECRET_KEY=       # fee payer + faucet (devnet only)
BOX_SIGNER_SECRET_KEY=     # box key (on the box only)
QUICKNODE_STREAM_SECRET=   # the Stream's security token (32+ chars); the webhook is closed while empty
# QUICKNODE_API_KEY=       # only for `pnpm quicknode:stream` (creates the Stream via the API)
# HUDDLE_KEYS_DIR=         # where scripts/solana-setup.ts keeps devnet keys (default ./keys, gitignored)

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_SOCCER=
ELEVENLABS_VOICE_NFL=
ELEVENLABS_VOICE_CALM=
AGENT_TOOLS_SECRET=        # shared secret header for ElevenLabs agent server tools

# --- Sports data ---
SPORTS_PROVIDER=replay     # replay | espn | apifootball
API_FOOTBALL_KEY=
# REPLAY_DIR=              # folder of replay timelines (default: ./replays)
# ESPN_SOCCER_LEAGUES=     # comma list of ESPN soccer league slugs to poll
# SPORTS_POLL_MS=          # live adapter poll interval (5000 to 10000)

# --- Gemini Prediction Markets (public reads, no key) ---
GEMINI_API_BASE=https://api.gemini.com
GEMINI_MOCK=               # set to 1 to force the offline mock
# GEMINI_FALLBACK=none     # hide the Gemini column instead of showing flagged sample odds when Gemini is unreachable
# GEMINI_EVENT_TICKERS=    # comma list of event tickers to pin instead of searching (e.g. after TEN at DAL settles)
# GEMINI_TIMEOUT_MS=3000
# GEMINI_CACHE_MS=10000

# --- Optional announcer overrides (see docs/workstreams/A6.md) ---
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_AGENT_ID_SOCCER=
# ELEVENLABS_AGENT_ID_NFL=
# ELEVENLABS_AGENT_ID_CALM=
# ELEVENLABS_AGENT_LLM= ELEVENLABS_AGENT_TTS_MODEL= ELEVENLABS_SFX_MODEL=   # setup scripts only
# ELEVENLABS_MAX_CONCURRENCY=3
# ANNOUNCER_TTS_BUDGET_MS=2200  ANNOUNCER_URGENT_BUDGET_MS=800  ANNOUNCER_RELAXED_BUDGET_MS=4000
# ANNOUNCER_TTS_COOLDOWN_MS=30000
# ANNOUNCER_LLM_LINES=0    # force template lines;  ANNOUNCER_LLM_TALK=0 forces rule-only TALK replies
# SFX_DIR=packages/announcer/assets/sfx

# --- Demo runner / box (optional) ---
# BRIDGE_PORT=7777         # mock bridge port used by `pnpm demo`
# HUDDLE_NO_LAN=1          # do not advertise the LAN IP in join links when PUBLIC_ENGINE_URL is empty
# LOG_LEVEL=info
