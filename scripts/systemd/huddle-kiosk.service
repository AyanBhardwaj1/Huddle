[Unit]
Description=Huddle kiosk (Chromium at http://localhost:8080/box)
After=graphical.target huddle-engine.service
Wants=huddle-engine.service

[Service]
Type=simple
User=@RUN_USER@
Environment=DISPLAY=:0
Environment=XAUTHORITY=@RUN_HOME@/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Wait for the engine before opening the browser.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -sf http://localhost:8080/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/bin/sh -c 'exec $(command -v chromium-browser || command -v chromium) --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --check-for-update-interval=31536000 --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream --overscroll-history-navigation=0 --password-store=basic http://localhost:8080/box/'
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
